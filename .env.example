# Example env file. DO NOT commit a real .env with these values filled in.

# Virtuals Protocol API key (https://app.virtuals.io → settings)
VIRTUALS_API_KEY=

# Wallet private key (Base chain, must hold ETH for gas + USDC for escrow)
WALLET_PRIVATE_KEY=

# Base mainnet (8453) or testnet (84532)
CHAIN_ID=8453

# Optional: Telegram alert bot for kill-switch notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
